            "card.translation.x": {
              "keys": [
                {"id":"card-slides-in","time":0.5,"value":300,"interpolation":"ease-out"},
                {"id":"card-settles","time":0.8,"value":240,"interpolation":"smooth"},
                {"id":"card-swings-right","time":1.6,"value":800,"interpolation":"smooth"},
                {"id":"card-swings-back","time":2.4,"value":240,"interpolation":"smooth"}
              ],
              "loop": {"mode":"repeat","from":"card-settles"}
            },
            "noise.translation.y": {
              "keys": [
                {"id":"noise-wanders","time":0,"value":0,"oscillate":{"amplitude":30,"frequency":2,"wave-shape":"noise","seed":7}}
              ]
            },
            "turn.translation.x": {
              "keys": [
                {"id":"turn-cut","time":1.2,"value":520,"interpolation":"ease-in-out","incoming":{"value":1040,"end-time":2.4}},
