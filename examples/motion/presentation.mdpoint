              ]
            },
            "wave.translation.y": {
              "keys": [
                {"id":"wave-bobs","time":0,"value":0,"oscillate":{"amplitude":30,"frequency":1,"phase":90,"wave-shape":"triangle"}}
              ]
            },
            "zoom.scale.x": {
              "keys": [
                {"id":"zoom-grows-x","time":2,"value":2,"interpolation":"ease-in-out","exponential-scale":true}
              ]
            },
