{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://markdownpoint.com/format/schemas/1.0/theme-package.schema.json",
  "description": "The list of a theme package's files. A package is refused unless its folder holds exactly these files at these sizes and digests.",
  "type": "object",
  "properties": {
    "markdownpoint": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]{0,8})(?![\\s\\S])",
      "description": "The file's format version in quotes, such as \"1.0\". Its major and minor numbers each have at most nine digits and no leading zero."
    },
    "type": {
      "const": "theme-package",
      "description": "What the file is."
    },
    "files": {
      "description": "Each of the theme's files in the package with its size and digest. That includes master.json. The theme's files are listed by their paths in the theme's folder.",
      "type": "object",
      "properties": {
        "master.json": {
          "type": "object",
          "allOf": [
            {
              "$ref": "#/definitions/manifest-file"
            }
          ],
          "description": "The theme's master. The SHA-256 digest and size of one file. Its key in `files` is the file's path."
        }
      },
      "required": [
        "master.json"
      ],
      "propertyNames": {
        "anyOf": [
          {
            "enum": [
              "master.json"
            ]
          },
          {
            "pattern": "^(?=(?:(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.|(?![^/\\\\#?\\u007f-\\u009f])))[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f]*[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f .](?:\\/(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.|(?![^/\\\\#?\\u007f-\\u009f])))[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f]*[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f .])*)(?![\\s\\S]))(?!(?:[mM][aA][nN][iI][fF][eE](?:[sSſ][tT]\\.[jJ][sSſ][oO][nN]|(?:ﬅ|ﬆ)\\.[jJ][sSſ][oO][nN])|[pP][rR][eE][vV][iI][eE][wW][sSſ]|[eE][xX][aA][mM][pP][lL][eE])(?:\\/|(?![\\s\\S])))(?!\\.)(?!Icon\\r(?:\\/|(?![\\s\\S])))[^/]+(?:\\/(?!\\.)(?!Icon\\r(?:\\/|(?![\\s\\S])))[^/]+)*(?![\\s\\S])"
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/definitions/manifest-file"
          }
        ],
        "description": "The SHA-256 digest and size of one file. Its key in `files` is the file's path."
      }
    }
  },
  "required": [
    "markdownpoint",
    "type",
    "files"
  ],
  "additionalProperties": false,
  "definitions": {
    "manifest-file": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "description": "Its SHA-256 digest in 64 lowercase hexadecimal digits."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Its size. It is in bytes."
        }
      },
      "required": [
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    }
  }
}
