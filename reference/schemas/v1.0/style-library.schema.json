{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://markdownpoint.com/format/schemas/v1.0/style-library.schema.json",
  "description": "Styles from the style library, in a file of their own.",
  "type": "object",
  "properties": {
    "markdownpoint": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]{0,8})(?![\\s\\S])",
      "description": "The format version, as a major and a minor number in quotes: \"1.0\"."
    },
    "type": {
      "const": "style-library",
      "description": "What the file is."
    },
    "styles": {
      "type": "array",
      "items": {
        "description": "One style of the style library: the restyle it copies onto an image, and the prompt for its example image.",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?:(?![\\u0000-\\u001f\\u007f-\\u009f])[\\t\\n\\u000b\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff])*[^\\t\\n\\u000b\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\u0000-\\u001f\\u007f-\\u009f][^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
            "description": "The style's name, on one line that isn't blank and has no control characters."
          },
          "reference-prompt": {
            "type": "string",
            "pattern": "^(?:(?![\\u0000])[\\t\\n\\u000b\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff])*[^\\t\\n\\u000b\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\u0000][^\\u0000]*(?![\\s\\S])",
            "description": "The prompt for the style's example image, as text that isn't blank."
          },
          "prompt": {
            "type": "string",
            "pattern": "^(?:(?![\\u0000])[\\t\\n\\u000b\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff])*[^\\t\\n\\u000b\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\u0000][^\\u0000]*(?![\\s\\S])",
            "description": "How the style changes an image, as an edit prompt that isn't blank."
          },
          "transparent-background": {
            "type": "boolean",
            "description": "Whether images in the style have transparent backgrounds."
          }
        },
        "required": [
          "name",
          "reference-prompt",
          "prompt"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "The styles, at least one, each a library style."
    }
  },
  "required": [
    "markdownpoint",
    "type",
    "styles"
  ],
  "additionalProperties": false
}
