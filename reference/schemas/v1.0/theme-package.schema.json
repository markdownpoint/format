{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://markdownpoint.com/format/schemas/v1.0/theme-package.schema.json",
  "description": "The list of a theme package's files. It's used to check that the package is complete.",
  "type": "object",
  "properties": {
    "markdownpoint": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]{0,8})(?![\\s\\S])",
      "description": "The format version. It is a major and a minor number in quotes: \"1.0\"."
    },
    "type": {
      "const": "theme-package",
      "description": "What the file is."
    },
    "theme": {
      "type": "string",
      "pattern": "^(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?![\\s\\S]))(?:[a-z](?:[a-z0-9]|-(?!-))*[a-z0-9]|[a-z])(?![\\s\\S])",
      "description": "The key of the theme in the package. It is the name of the theme's folder."
    },
    "files": {
      "description": "Each file of the theme with its size and digest. That includes master.json.",
      "type": "object",
      "properties": {
        "master.json": {
          "allOf": [
            {
              "$ref": "#/definitions/manifest-file"
            }
          ],
          "description": "The theme's master."
        }
      },
      "required": [
        "master.json"
      ],
      "propertyNames": {
        "anyOf": [
          {
            "enum": [
              "master.json"
            ]
          },
          {
            "pattern": "^(?=(?:(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.|(?![^/\\\\#?\\u007f-\\u009f])))[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f]*[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f .](?:\\/(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.|(?![^/\\\\#?\\u007f-\\u009f])))[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f]*[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f .])*)(?![\\s\\S]))(?!(?:manifest\\.json|previews|example)(?:\\/|(?![\\s\\S])))(?!\\.)(?!Icon\\r(?:\\/|(?![\\s\\S])))[^/]+(?:\\/(?!\\.)(?!Icon\\r(?:\\/|(?![\\s\\S])))[^/]+)*(?![\\s\\S])"
          }
        ]
      },
      "additionalProperties": {
        "$ref": "#/definitions/manifest-file"
      }
    }
  },
  "required": [
    "markdownpoint",
    "type",
    "theme",
    "files"
  ],
  "additionalProperties": false,
  "definitions": {
    "manifest-file": {
      "description": "One file of a theme package.",
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "description": "Its SHA-256 digest in 64 lowercase hexadecimal digits."
        },
        "bytes": {
          "allOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "bytes"
            }
          ],
          "description": "Its size."
        }
      },
      "required": [
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    }
  }
}
