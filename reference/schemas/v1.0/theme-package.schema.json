{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://markdownpoint.com/format/schemas/v1.0/theme-package.schema.json",
  "description": "The list of a theme package's files. It's used to check that the package is complete.",
  "type": "object",
  "properties": {
    "markdownpoint": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]{0,8})(?![\\s\\S])",
      "description": "The format version, as a major and a minor number in quotes: \"1.0\"."
    },
    "type": {
      "const": "theme-package",
      "description": "What the file is."
    },
    "theme": {
      "type": "string",
      "pattern": "^(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?![\\s\\S]))(?:[a-z](?:[a-z0-9]|-(?!-))*[a-z0-9]|[a-z])(?![\\s\\S])",
      "description": "The key of the theme in the package, the name of its folder."
    },
    "files": {
      "type": "array",
      "items": {
        "description": "One file of a theme package.",
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^(?=(?:(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.|(?![^/\\\\#?\\u007f-\\u009f])))[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f]*[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f .](?:\\/(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.|(?![^/\\\\#?\\u007f-\\u009f])))[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f]*[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f .])*)(?![\\s\\S]))(?!(?:manifest\\.json|previews|example)(?:\\/|(?![\\s\\S])))(?!\\.)(?!Icon\\r(?:\\/|(?![\\s\\S])))[^/]+(?:\\/(?!\\.)(?!Icon\\r(?:\\/|(?![\\s\\S])))[^/]+)*(?![\\s\\S])",
            "description": "Its path inside the package, as a theme's file path."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
            "description": "Its SHA-256 digest, as 64 lowercase hexadecimal digits."
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Its size."
          }
        },
        "required": [
          "file",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {
          "file": {
            "const": "master.json"
          }
        },
        "required": [
          "file"
        ]
      },
      "description": "Each file of the theme, once, master.json included, with its size and digest."
    }
  },
  "required": [
    "markdownpoint",
    "type",
    "theme",
    "files"
  ],
  "additionalProperties": false
}
