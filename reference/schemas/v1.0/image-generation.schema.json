{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://markdownpoint.com/format/schemas/v1.0/image-generation.schema.json",
  "description": "How a generated image was made: what was asked, what for, and the image that came back. The `<id>` in its file name is the record's lowercase UUID.",
  "type": "object",
  "properties": {
    "markdownpoint": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]{0,8})(?![\\s\\S])",
      "description": "The format version. It is a major and a minor number in quotes: \"1.0\"."
    },
    "type": {
      "const": "image-generation",
      "description": "What the file is."
    },
    "created": {
      "type": "string",
      "pattern": "^(?!0000)(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z(?![\\s\\S])",
      "description": "When the image was made: a UTC timestamp to the millisecond, such as 2026-10-16T09:30:00.000Z. Without it, the time isn't known."
    },
    "name": {
      "allOf": [
        {
          "$ref": "#/definitions/nonblank-line"
        }
      ],
      "description": "The name an image object gets from the record when it has no name of its own. It is one line that isn't blank and has no control characters. Without it, the name is made from the prompt."
    },
    "target": {
      "description": "What the image was made for.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "presentation-background"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "slide-background"
            },
            "slide": {
              "allOf": [
                {
                  "$ref": "#/definitions/stable-id"
                }
              ],
              "description": "The id of the slide with the background, or of the slide the image object is on."
            }
          },
          "required": [
            "type",
            "slide"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "image-object"
            },
            "slide": {
              "allOf": [
                {
                  "$ref": "#/definitions/stable-id"
                }
              ],
              "description": "The id of the slide with the background, or of the slide the image object is on."
            },
            "composition": {
              "allOf": [
                {
                  "$ref": "#/definitions/stable-id"
                }
              ],
              "description": "The id of the composition the image object is on."
            },
            "object": {
              "type": "string",
              "pattern": "^(?:[a-z](?:[a-z0-9]|-(?!-))*[a-z0-9]|[a-z])(?![\\s\\S])",
              "description": "The image object's id."
            }
          },
          "required": [
            "type",
            "object"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "properties": {
                "slide": true
              },
              "required": [
                "slide"
              ]
            },
            {
              "properties": {
                "composition": true
              },
              "required": [
                "composition"
              ]
            }
          ]
        }
      ]
    },
    "request": {
      "description": "What was asked of the image model.",
      "type": "object",
      "properties": {
        "instructions": {
          "enum": [
            "markdownpoint/image-prompt/1",
            "none"
          ],
          "description": "The version of the instructions MarkdownPoint wraps the prompt in. It is `none` when the prompt was asked as written, for example by another tool."
        },
        "prompt": {
          "allOf": [
            {
              "$ref": "#/definitions/request-text"
            }
          ],
          "description": "The words asked for, in Unicode NFC. Each run of white space is one space, and there is none at either end. It isn't empty or `none`."
        },
        "image-style": {
          "anyOf": [
            {
              "$ref": "#/definitions/request-text"
            },
            {
              "const": "none"
            }
          ],
          "description": "The style the image was made in. Its words are written the same way as the prompt's. It is `none` for no style."
        },
        "provider": {
          "enum": [
            "google",
            "openai"
          ],
          "description": "Who makes the image model."
        },
        "model": {
          "allOf": [
            {
              "$ref": "#/definitions/nonblank-line"
            }
          ],
          "description": "The image model's name, on one line that isn't blank and has no control characters."
        },
        "parameters": {
          "description": "The settings the model was asked with.",
          "type": "object",
          "properties": {
            "aspect-ratio": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990|9007199254740991):(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990|9007199254740991)(?![\\s\\S])",
              "description": "The proportions asked for: width:height, such as 16:9. Both are whole numbers from 1 to 9.007199254740991 × 10¹⁵. Neither has a leading zero."
            },
            "transparent-background": {
              "type": "boolean",
              "description": "Whether a transparent background was asked for."
            },
            "size": {
              "allOf": [
                {
                  "$ref": "#/definitions/nonblank-line"
                }
              ],
              "description": "The size asked for, in the model's own words. It is one line that isn't blank and has no control characters."
            },
            "quality": {
              "allOf": [
                {
                  "$ref": "#/definitions/nonblank-line"
                }
              ],
              "description": "The quality asked for, in the model's own words. It is one line that isn't blank and has no control characters. Without it, no quality was asked for."
            }
          },
          "required": [
            "aspect-ratio",
            "transparent-background",
            "size"
          ],
          "additionalProperties": false
        },
        "original": {
          "description": "The image a restyle was applied to. Without it, the image was made from the prompt alone.",
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^(?=(?:media|generated)\\/)(?![\\s\\S]*:)(?=(?:(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.|(?![^/\\\\#?\\u007f-\\u009f])))[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f]*[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f .](?:\\/(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.|(?![^/\\\\#?\\u007f-\\u009f])))[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f]*[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f .])*)(?![\\s\\S]))(?!(?:[^/]*\\/)*\\.)(?!generated\\/(?:[^/]*\\/)*[^/]*\\.json(?![\\s\\S]))[\\s\\S]*\\.(?:[pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[gG][iI][fF]|[wW][eE][bB][pP]|[sS][vV][gG]|[aA][vV][iI][fF]|[bB][mM][pP])(?![\\s\\S])",
              "description": "Its path in the presentation's folder when the image was sent. It ends in an image's extension. MarkdownPoint doesn't update it when the image is renamed or moved. The digest identifies the image."
            },
            "sha256": {
              "allOf": [
                {
                  "$ref": "#/definitions/sha256"
                }
              ],
              "description": "The SHA-256 digest of its bytes in 64 lowercase hexadecimal digits."
            }
          },
          "required": [
            "file",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "instructions",
        "prompt",
        "image-style",
        "provider",
        "model",
        "parameters"
      ],
      "additionalProperties": false
    },
    "output": {
      "description": "The image that came back.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(?=(?:(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.|(?![^/\\\\#?\\u007f-\\u009f])))[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f]*[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f .](?:\\/(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³])(?:\\.|(?![^/\\\\#?\\u007f-\\u009f])))[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f]*[^<>:\"|?*\\u0000-\\u001f/\\\\#?\\u007f-\\u009f .])*)(?![\\s\\S]))(?!(?:[^/]*\\/)*\\.)(?!generated\\/(?:[^/]*\\/)*[^/]*\\.json(?![\\s\\S]))(?:generated\\/[^/]*|media\\/(?:[^/]*\\/)*[^/]*)\\.(?:[pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG])(?![\\s\\S])",
          "description": "Where it is, ending in .png, .jpg, or .jpeg. It is first written directly under generated/. After it is renamed or moved, it can be anywhere under media/."
        },
        "sha256": {
          "allOf": [
            {
              "$ref": "#/definitions/sha256"
            }
          ],
          "description": "The SHA-256 digest of its bytes in 64 lowercase hexadecimal digits."
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Its size."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Its width as drawn, turned by the orientation its file states."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Its height as drawn, turned by the orientation its file states."
        }
      },
      "required": [
        "file",
        "sha256",
        "bytes",
        "width",
        "height"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "markdownpoint",
    "type",
    "target",
    "request",
    "output"
  ],
  "additionalProperties": false,
  "definitions": {
    "nonblank-line": {
      "type": "string",
      "pattern": "^(?:(?![\\u0000-\\u001f\\u007f-\\u009f])[\\t\\n\\u000b\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff])*[^\\t\\n\\u000b\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff\\u0000-\\u001f\\u007f-\\u009f][^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
      "description": "one line that isn't blank and has no control characters"
    },
    "request-text": {
      "type": "string",
      "pattern": "^(?!none(?![\\s\\S]))[^\\t\\n\\u000b\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]+(?: [^\\t\\n\\u000b\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]+)*(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "description": "64 lowercase hexadecimal digits"
    },
    "stable-id": {
      "type": "string",
      "pattern": "^(?:[a-z](?:[a-z0-9]|-(?!-))*[a-z0-9]|[a-z])(?![\\s\\S])",
      "description": "an id, such as \"title-card\""
    }
  }
}
